# ─── SB Stocks Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/sbstocks
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/sbstocks

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Stock Market API (Free tier — pick one)
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# Finnhub: https://finnhub.io/dashboard
FINNHUB_KEY=your_finnhub_key

# Starting virtual balance for new users
STARTING_BALANCE=10000
